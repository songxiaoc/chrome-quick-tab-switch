{
  "manifest_version": 3,
  "name": "Quick Tab Switch",
  "description": "快速切换左右相邻的标签页",
  "version": "1.0",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "switch-to-previous-tab": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "切换到左侧标签页"
    },
    "navigate-tab-history": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "切换到右侧标签页"
    }
  }
}
