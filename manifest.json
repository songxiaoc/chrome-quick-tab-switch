{
  "manifest_version": 3,
  "name": "Quick Tab Switch",
  "description": "快速切换访问的标签页",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "switch-to-previous-tab": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "后退"
    },
    "navigate-tab-history": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "前进"
    }
  }
}
